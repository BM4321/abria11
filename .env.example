# --- Database (Supabase Postgres) ---
# Use the IPv4 pooler connection string from Supabase Dashboard > Connect > ORM > Prisma.
# NOT the db.<ref>.supabase.co host (IPv6-only).
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode (port 5432) connection used by `prisma migrate`. Required by schema.prisma.
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Public site URL ---
# Canonical origin for SEO, the sitemap and auth/password-reset links. Set it in
# production so emailed links never depend on request headers. Also add
# <this URL>/auth/confirm and <this URL>/auth/callback to Supabase >
# Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SITE_URL="https://abrialogistics.co.tz"

# --- Supabase Auth / Client ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="<secret-key>"

# --- Notifications (optional) ---
# RESEND_API_KEY="<resend-api-key>"
# ABRIA_WHATSAPP_NUMBER="<whatsapp-number>"
# ABRIA_OPS_EMAIL="<ops-email>"

# --- Seed / admin user ---
ABRIA_ADMIN_EMAIL="admin@abria.co.tz"
ABRIA_ADMIN_PASSWORD="<admin-password>"

# --- First-run admin setup (/setup) ---
# Required to enable the /setup page. Without it, /setup refuses to create an
# account. Generate a random value (e.g. `openssl rand -hex 32`), set it here
# and in your deploy platform, share it out-of-band with whoever runs setup,
# then rotate/remove it once the founding admin account exists.
ABRIA_SETUP_TOKEN="<random-one-time-setup-token>"
