generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Operation staff users. In production these are managed by Supabase Auth
// (auth.users); this table records the ops profile + role for the dashboard.
model OpsUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("OPERATIONS")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[]
}

// Atomic per-year sequence used by the Request ID engine (ABR-YYYY-NNNNNN).
model RequestCounter {
  year Int @id
  seq  Int @default(0)
}

// Atomic per-year sequence used by the Partner ID engine (ABP-YYYY-NNNNNN).
model PartnerCounter {
  year Int @id
  seq  Int @default(0)
}

// Atomic per-year sequence used by the Shipment ID engine (SHP-YYYY-NNNNNN).
model ShipmentCounter {
  year Int @id
  seq  Int @default(0)
}

// A customer transport request (Phase 1 core).
model Request {
  id                 String   @id @default(cuid())
  requestId          String   @unique // ABR-YYYY-NNNNNN

  // Customer details
  companyName        String?
  contactPerson      String
  phone              String
  email              String?

  // Shipment
  pickupLocation     String
  deliveryLocation   String
  cargoType          String
  cargoDescription   String?
  quantity           Int?
  weight             Float?
  dimensions         String?
  numberOfPackages   Int?
  cargoValue         Float?

  // Transport
  transportType      String
  transportDate      DateTime?
  preferredPickupDate DateTime?
  requiredDeliveryDate DateTime?
  specialHandling    String?
  additionalInstructions String?

  status             String   @default("NEW_REQUEST")
  assignedOperatorId String?
  assignedOperator   OpsUser? @relation(fields: [assignedOperatorId], references: [id])
  assignedPartnerId  String?
  assignedPartner    Partner? @relation(fields: [assignedPartnerId], references: [id])

  // Proof of delivery (POD)
  podFileKey         String?
  podFileName        String?
  podNotes           String?
  podReceivedAt      DateTime?
  podReceivedBy      String?

  quotation Quotation?
  history    RequestStatusHistory[]
  notes      InternalNote[]
  shipment   Shipment?

  // Answers to fields added in Admin > Forms (key → value).
  extra              Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Audit trail of request status changes.
model RequestStatusHistory {
  id             String   @id @default(cuid())
  requestId      String
  request        Request  @relation(fields: [requestId], references: [id])
  fromStatus     String
  toStatus       String
  changedByName  String?
  changedByEmail String?
  changedAt      DateTime @default(now())

  @@index([requestId])
}

// A transport partner / truck registration (Phase 3).
model Partner {
  id                 String   @id @default(cuid())
  partnerId          String   @unique // ABP-YYYY-NNNNNN

  // Company / contact
  companyName        String?
  contactPerson      String
  phone              String
  email              String?

  // Vehicle
  truckType          String
  truckCapacity      String?
  registrationNumber String
  makeModel          String?
  currentLocation    String?
  routesCovered      String?

  status             String   @default("PENDING") // PENDING | VERIFIED | REJECTED | SUSPENDED

  requests Request[]
  trucks   Truck[]
  shipments Shipment[]

  // Answers to fields added in Admin > Forms (key → value).
  extra              Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
}

// A single vehicle belonging to a partner (console: Trucks).
model Truck {
  id                 String   @id @default(cuid())
  partnerId          String
  partner            Partner  @relation(fields: [partnerId], references: [id])

  registrationNumber String   @unique
  truckType          String
  capacity           String?
  makeModel          String?
  region             String?
  status             String   @default("AVAILABLE") // AVAILABLE | ASSIGNED | MAINTENANCE | INACTIVE | PENDING
  verification       String   @default("PENDING") // PENDING | VERIFIED

  shipments Shipment[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([partnerId])
  @@index([status])
}

// A shipment converted from a request and assigned to a carrier (console: Shipments).
model Shipment {
  id            String   @id @default(cuid())
  shipmentId    String   @unique // SHP-YYYY-NNNNNN

  requestId     String?  @unique
  request       Request? @relation(fields: [requestId], references: [id])

  customerName      String?
  customerCompany   String?
  customerPhone     String?
  cargoDescription  String?
  weight            Float?
  quantity          Int?
  pickupLocation    String
  deliveryLocation  String

  partnerId     String?
  partner       Partner? @relation(fields: [partnerId], references: [id])
  truckId       String?
  truck         Truck?   @relation(fields: [truckId], references: [id])
  driverName    String?
  driverPhone   String?

  status        String   @default("ASSIGNED") // ASSIGNED | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | DELAYED
  eta           DateTime?
  deliveredAt   DateTime?
  progress      Float    @default(0)
  delayed       Boolean  @default(false)
  delayNote     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([partnerId])
}

// Customer-facing and internal console notifications.
model Notification {
  id        String   @id @default(cuid())
  category  String   // Requests | Quotes | Shipments | Carriers | System
  icon      String   @default("ph-bell")
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([read])
}

// Internal staff notes attached to a request (console: Request detail).
model InternalNote {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  authorName String
  text       String
  createdAt  DateTime @default(now())

  @@index([requestId])
}

// Audit trail for console and website changes (console: Audit Logs).
model AuditLog {
  id          String   @id @default(cuid())
  userName    String
  action      String
  resource    String
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Editable public website pages (admin: Website > Pages).
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  url       String
  status    String   @default("PUBLISHED") // PUBLISHED | DRAFT
  summary   String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Media library entries (admin: Website > Media).
model MediaAsset {
  id        String   @id @default(cuid())
  fileName  String
  url       String
  category  String   @default("General")
  alt       String?
  size      String?
  dimensions String?
  uploadedBy String?
  // Image slot on the public site this asset fills (see src/lib/media-slots.ts).
  // At most one asset per slot.
  placement   String? @unique
  // Object path in the Supabase Storage "media" bucket, when uploaded there.
  storagePath String?

  createdAt DateTime @default(now())
}

// Simple key/value settings store (admin: Settings).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Reusable public forms and their field definitions (admin: Forms).
model FormDefinition {
  id          String   @id @default(cuid())
  formId      String   @unique // quote | truck | contact | partner
  name        String
  description String?
  status      String   @default("PUBLISHED") // PUBLISHED | DRAFT
  publicPath  String?
  fields      Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A quotation attached to a request (Phase 2).
model Quotation {
  id              String   @id @default(cuid())
  requestId       String   @unique
  request         Request  @relation(fields: [requestId], references: [id])

  // Cost breakdown (stored as JSON lines: { label, amount }).
  items           Json     @default("[]")
  transportCost   Float    @default(0)
  loadingCost     Float    @default(0)
  offloadingCost  Float    @default(0)
  tolls           Float    @default(0)
  fuelSurcharge   Float    @default(0)
  handling        Float    @default(0)
  insurance       Float    @default(0)
  otherCharges    Float    @default(0)
  vat             Float    @default(0)
  total           Float    @default(0)
  validUntil      DateTime?
  notes           String?
  sentAt          DateTime?
  sentTo          String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Contact-form messages and any other form without its own table.
model FormSubmission {
  id        String   @id @default(cuid())
  formId    String   // contact
  name      String
  email     String?
  phone     String?
  data      Json     // every answer, keyed by field key
  status    String   @default("OPEN") // OPEN | IN_REVIEW | CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, createdAt])
}
